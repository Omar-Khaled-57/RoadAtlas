# Server
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas (leave empty to run Phase 1 without a DB)
MONGODB_URI=

# Auth (single owner; required in production)
# Generate with: openssl rand -base64 48
JWT_SECRET=
ADMIN_EMAIL=you@example.com
# Generate with: node -e "import('bcryptjs').then(b=>console.log(b.hashSync('your-password',10)))"
ADMIN_PASSWORD_HASH=
