# Server
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas (leave empty to run Phase 1 without a DB)
MONGODB_URI=

# Auth (required in production)
# Generate with: openssl rand -base64 48
JWT_SECRET=
# Bootstrap admin. Optional when a database is set (provision users with
# `npm run user:create -w server` instead); required without one.
ADMIN_EMAIL=you@example.com
# Generate with: node -e "import('bcryptjs').then(b=>console.log(b.hashSync('your-password',12)))"
ADMIN_PASSWORD_HASH=

# Logging: debug | info | warn | error (defaults to debug in development, info in production)
LOG_LEVEL=debug
