generator client {
  provider = "prisma-client-js"
  output = "../../node_modules/@prisma/client/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  displayName   String?
  sessionVersion Int     @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  roadmaps   Roadmap[]
  steps      Step[]
  progresses Progress[]
  comparisons Comparison[]
  metrics    Metric[]
  notes      Note[]
  decisions  Decision[]
  focus      Focus?
}

model Roadmap {
  id          String   @id @default(uuid())
  ownerId     String
  visibility  String   @default("public")
  kind        String
  title       Json
  description Json?
  parentId    String?
  techId      String?
  order       Int      @default(0)
  legacyKey   String?
  prerequisites Json   @default("[]")
  topics      Json     @default("[]")
  paused      Boolean  @default(false)
  status      String?
  icon        String?
  image       String?
  revision    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner    User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  steps    Step[]
  children Roadmap[] @relation("RoadmapParent")
  parent   Roadmap?  @relation("RoadmapParent", fields: [parentId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([parentId])
  @@index([ownerId, legacyKey], map: "roadmap_owner_legacykey_idx")
}

model Step {
  id             String   @id @default(uuid())
  ownerId        String
  roadmapId      String
  title          Json
  description    Json?
  resources      Json     @default("[]")
  order          Int      @default(0)
  legacyKey      String?
  stage          String?
  note           Json?
  done           Boolean?
  revision       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  linkedRoadmapId String?
  linkedStepId   String?

  owner    User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  roadmap  Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  progress Progress[]

  @@index([ownerId])
  @@index([roadmapId])
  @@index([ownerId, legacyKey], map: "step_owner_legacykey_idx")
}

model Progress {
  id        String     @id @default(uuid())
  ownerId   String
  stepId    String
  done      Boolean    @default(false)
  status    String?
  percent   Int?
  completedAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  owner  User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  step   Step @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([stepId])
  @@index([ownerId, stepId], map: "progress_owner_step_idx")
}

model Comparison {
  id             String   @id @default(uuid())
  ownerId        String
  visibility     String   @default("public")
  title          Json
  candidateTechIds Json   @default("[]")
  criteria       Json     @default("[]")
  conclusion     Json?
  chosenTechId   String?
  revisitAt      DateTime?
  evidence       Json     @default("[]")
  revision       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

model Metric {
  id        String   @id @default(uuid())
  ownerId   String
  visibility String  @default("public")
  techId    String
  key       String
  axis      Json
  points    Json     @default("[]")
  finding   Json
  evidence  Json     @default("[]")
  revision  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

model Note {
  id        String   @id @default(uuid())
  ownerId   String
  visibility String  @default("public")
  targetType String
  targetId   String
  title      Json
  content    Json
  tags       Json     @default("[]")
  references Json     @default("[]")
  revision   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([targetId])
}

model Decision {
  id          String   @id @default(uuid())
  ownerId     String
  visibility  String   @default("public")
  context     Json
  alternatives Json    @default("[]")
  decision    Json
  consequences Json
  revisitAt   DateTime?
  links       Json     @default("[]")
  revision    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

model Focus {
  id                    String   @id @default(uuid())
  ownerId               String   @unique
  visibility            String   @default("public")
  currentTechId         String?
  currentProjectId      String?
  lastVisited           Json?
  items                 Json     @default("[]")
  weeklyFocus           Json     @default("[]")
  weeklyFocusConfigured Boolean  @default(false)
  revision              Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}
