{
  "name": "@roadatlas/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "db:dev": "node scripts/dev-db.mjs",
    "build": "tsup src/index.ts --format esm --target node20 --out-dir dist --clean",
    "build:api": "esbuild src/serverless.ts --bundle --platform=node --format=cjs --target=node22 --packages=external --outfile=../api/_server.cjs",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "user:create": "node scripts/create-user.mjs",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs"
  },
  "dependencies": {
    "@types/pg": "8.23.1",
    "bcryptjs": "*",
    "cookie-parser": "*",
    "cors": "*",
    "dotenv": "*",
    "express": "*",
    "express-rate-limit": "*",
    "helmet": "*",
    "jsonwebtoken": "*",
    "pg": "8.23.1",
    "zod": "*"
  },
  "devDependencies": {
    "@types/cookie-parser": "*",
    "@types/cors": "*",
    "@types/express": "*",
    "@types/jsonwebtoken": "*",
    "@types/node": "*",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsup": "*",
    "tsx": "*",
    "typescript": "*",
    "vitest": "^5.0.5"
  }
}
